{
  "expo": {
    "name": "FTTechApp",
    "slug": "fttechapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ie.geaftireland.fttechapp",
      "infoPlist": {
        "NSCameraUsageDescription": "FTTechApp uses the camera so you can take photos for issues, visits and handovers.",
        "NSPhotoLibraryUsageDescription": "FTTechApp opens your photo library so you can attach photos and files.",
        "NSPhotoLibraryAddUsageDescription": "FTTechApp can save photos and exported files to your photo library."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "ie.geaftireland.fttechapp",
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sharing"
    ],
    "backgroundColor": "#000F41"
  }
}
